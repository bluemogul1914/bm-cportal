# Blue Mogul Portal — .env template for standalone docker-compose deployment
# Copy to .env, fill required values, then: docker compose up -d --build

# ── REQUIRED ────────────────────────────────────────────────────────────
# Password for the bundled PostgreSQL (you choose it — used only by this deployment)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Secret used to sign session cookies (use: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Public URL of this deployment (no trailing slash)
# Local:  http://localhost:3000
# Prod:   https://portal.bluemogul.us
APP_URL=http://localhost:3000

# Host port the app listens on (default 3000)
PORT=3000

# ── OPTIONAL: AI / knowledge ────────────────────────────────────────────
# AnythingLLM endpoint. Portal AI assistant prefers it over Ollama when set.
# Example: https://anythingllm.bluemogul.us
ANYTHINGLLM_URL=

# ── OPTIONAL: provider keys ─────────────────────────────────────────────
# Most integrations (D&H, Hetzner, Vultr, Stripe connect, etc.) store their
# own credentials in the system_settings table via the admin UI. Only set
# these env vars when the deployment should override them globally.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
TWENTY_CRM_API_KEY=
TWENTY_API_URL=

# ── OPTIONAL: provider vars read by config.php ──────────────────────────
# Only needed for integrations that read env instead of system_settings.
# Uncomment + fill as needed for your deployment.
#ENOM_UID=
#ENOM_PW=
#HOSTWINDS_API_EMAIL=
#HOSTWINDS_API_KEY=
#JUMPCLOUD_API_KEY=
#JUMPCLOUD_ORG_ID=
#ITARIAN_API_KEY=
#ITARIAN_API_URL=
#UISP_API_KEY=
#RC_API_KEY=
#RC_AUTH_USERID=
#MATRIX_USER=
#MATRIX_PASSWORD=
#OLLAMA_URL=
#COOLIFY_URL=
#COOLIFY_TOKEN=
#GRAFANA_URL=
#FLOWISE_URL=
#HUBSPOT_TOKEN=
#PROXYCURL_API_KEY=