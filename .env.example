# Blue Mogul Suite — .env template for the standalone docker-compose deployment
#
# Copy to .env, fill the REQUIRED values, then:
#   docker compose up -d --build
#
# Only the three REQUIRED secrets have no safe default. Everything else either
# has a working default or is stored per-provider in the `system_settings` table
# and set from the admin UI (Settings → Providers). Set an env var only when the
# value must exist before the first request, or should override the DB globally.
#
# Generate a secret:  openssl rand -hex 32

# ── REQUIRED ────────────────────────────────────────────────────────────
# Password for the bundled PostgreSQL. The app's DATABASE_URL is built from this
# in docker-compose.yml, so set it here — never paste a value into the compose
# file itself.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Key material for the credential vault (AES-256-GCM; the key is derived from
# this via HKDF and never stored). REQUIRED when credentials are used: without
# it the vault cannot encrypt or decrypt, so stored secrets are unrecoverable.
# Treat it as permanent — changing it makes existing vault entries unreadable.
PORTAL_SECRET=change-me-to-a-long-random-hex-string

# ── DEPLOYMENT ──────────────────────────────────────────────────────────
# Public URL of this deployment (no trailing slash). Used for links, redirects
# and payment return URLs.  Local: http://localhost:3000
APP_URL=http://localhost:3000

# Host port the app listens on (default 3000).
PORT=3000

# true = read-only: mutating endpoints are blocked and the sync cron is
# disabled. Use for a preview/demo that shares production data.
PORTAL_SAFE_MODE=false

# Seeds the first admin account on a fresh install.
ADMIN_PASSWORD=

# Days of nightly database dumps the backup service retains.
BACKUP_RETENTION_DAYS=14

# ── OPTIONAL: AI ────────────────────────────────────────────────────────
# The portal AI assistant prefers AnythingLLM over Ollama when set. Without
# either, the assistant has no engine to call.
# Example: https://anythingllm.bluemogul.us
ANYTHINGLLM_URL=
OLLAMA_URL=
OLLAMA_MODEL=

# ── OPTIONAL: payments ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ── OPTIONAL: accounting (Xero = ledger of record, Wave = secondary) ────
# Xero pulls live bank records (incl. Relay) so it is the authoritative ledger;
# the Wave mirror is scoped to Blue Mogul Enterprise, LLC.
WAVE_TOKEN=
WAVE_API_URL=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=
XERO_OAUTH_REDIRECT_URI=

# ── OPTIONAL: outbound mail ─────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── OPTIONAL: infrastructure reporting ──────────────────────────────────
GRAFANA_URL=
UPTIME_KUMA_URL=
HOSTWINDS_API_URL=
HOSTWINDS_API_EMAIL=
HOSTWINDS_API_KEY=

# ── OPTIONAL: CRM bridge ────────────────────────────────────────────────
TWENTY_API_URL=
TWENTY_CRM_API_KEY=

# ── OPTIONAL: provider vars read by config.php ──────────────────────────
# Only needed for integrations that read env instead of system_settings.
# Uncomment + fill as needed.
#ENOM_UID=
#ENOM_PW=
#JUMPCLOUD_API_KEY=
#JUMPCLOUD_ORG_ID=
#ITARIAN_API_KEY=
#ITARIAN_API_URL=
#UISP_API_KEY=
#RC_API_KEY=
#RC_AUTH_USERID=
#MATRIX_USER=
#MATRIX_PASSWORD=
#COOLIFY_URL=
#COOLIFY_TOKEN=
#FLOWISE_URL=
#HUBSPOT_TOKEN=
#PROXYCURL_API_KEY=
